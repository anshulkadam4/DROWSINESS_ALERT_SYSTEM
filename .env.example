# ============================================================================
# AegisAlert System — Environment Configuration
# ============================================================================

# --- Oracle Database Connection Parameters ---
DB_USER=system
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=1521

# Configured Pluggable Database Service Name:
# - Oracle Database 21c XE default: XEPDB1
# - Oracle Database 23c Free default: FREEPDB1
DB_SERVICE_NAME=XEPDB1

# Optional Direct DSN (overrides host/port/service_name if set):
# DB_DSN=localhost:1521/XEPDB1

# Database Engine Mode:
# 'auto'   -> Attempts Oracle first; smoothly falls back to SQLite demo if offline
# 'oracle' -> Strict Oracle only (fails with error if Oracle unreachable)
# 'sqlite' -> Offline Demo Mode (uses local_demo.db)
DB_FORCE_ENGINE=auto

# Strict Oracle Mode (true / false):
# When true, suppresses SQLite fallback and surfaces detailed Oracle error
ORACLE_STRICT_MODE=false

# --- Flask Web Application Settings ---
SECRET_KEY=
PORT=5000
HOST=127.0.0.1

# Demo shortcuts must stay disabled outside an isolated evaluation/demo setup.
DEMO_MODE=false
DEMO_AUTO_LOGIN=false
